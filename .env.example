# ============================================================================
# Root Platform Bot Configuration
# Generate your DEV_TOKEN from https://dev.rootapp.com (Root Developer Portal)
# Leave blank to run in Standalone Local Mode (Web UI + Virtual Mic still work!)
# ============================================================================
DEV_TOKEN=

# Bot Chat Command Prefix (supports both /play and !play styles)
BOT_PREFIX=/

# External Collaborative Web Dashboard Server
WEB_HOST=0.0.0.0
WEB_PORT=3456
PUBLIC_WEB_URL=http://localhost:3456

# Audio & Virtual Microphone Routing
# Set AUTO_CREATE_VIRTUAL_MIC=true to automatically create the PipeWire/PulseAudio
# "Mulyo Music Bot Mic" virtual microphone on startup so Root Voice Chat can use it.
AUTO_CREATE_VIRTUAL_MIC=true
DEFAULT_VOLUME=75
# Optional explicit mpv audio device override (e.g. pulse/mulyo_music_sink or auto)
AUDIO_DEVICE=

# ============================================================================
# Phase 2: Spotify Integration (Reserved for Phase 2)
# ============================================================================
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
